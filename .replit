# Replit configuration for Vibedeo (Next.js 15 + Prisma + Postgres).
#
# Provision from the workspace panes before the first run:
#   - Database pane -> PostgreSQL       (sets DATABASE_URL in Secrets)
#   - Storage pane  -> Object Storage   (the SDK finds the default bucket by
#                                        itself; no env var to copy)
#
# Everything else goes in the Secrets pane — see .env.example.

modules = ["nodejs-24"]
run = "npm run build && npm run start"
entrypoint = "app/page.tsx"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npx prisma migrate deploy && npm run build"]
run = ["sh", "-c", "npm run start"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
NEXT_TELEMETRY_DISABLED = "1"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
