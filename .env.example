# ---------------------------------------------------------------------------
# Vibedeo environment variables
#
# On Replit these belong in the **Secrets** pane, not in a committed file.
# Locally, copy this file to `.env` and fill it in.
# ---------------------------------------------------------------------------

# Postgres. Set automatically by Replit when you provision the database
# from the Database pane. Locally, point it at any Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/vibedeo"

# --- Auth.js / NextAuth ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Back-compat alias read by Auth.js v5 as well:
NEXTAUTH_SECRET=""
# Public URL of the app, e.g. https://vibedeo.username.repl.co
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional — email/password sign-in works without it).
# Create credentials at https://console.cloud.google.com/apis/credentials and set
# the redirect URI to <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Seedance (video generation) --------------------------------------------
# Leave SEEDANCE_API_KEY empty to run in MOCK mode: jobs complete locally with a
# placeholder video so the whole loop is testable without spending credits.
SEEDANCE_API_KEY=""
SEEDANCE_API_BASE_URL="https://ark.ap-southeast.bytepluses.com/api/v3"
SEEDANCE_MODEL="seedance-1-0-pro-250528"
# Optional shared secret for the Seedance completion webhook (if your account
# supports callbacks). Requests must send it as `x-vibedeo-signature`.
SEEDANCE_WEBHOOK_SECRET=""

# --- Anthropic (prompt enhancement + character descriptions) ----------------
# Without a key the app falls back to a deterministic local enhancer.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Replit Object Storage ---------------------------------------------------
# Set automatically when you create a bucket from the Storage pane.
# If unset, files are written to ./.data/storage so local dev still works.
REPLIT_OBJECT_STORAGE_BUCKET_ID=""

# --- Worker ------------------------------------------------------------------
# Shared secret required by POST /api/worker/poll (the background job sweeper).
WORKER_SECRET=""
